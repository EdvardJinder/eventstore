  <ItemGroup>
    <ProjectReference Include="..\..\src\EventStoreCore.Abstractions\EventStoreCore.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\EventStoreCore.Hangfire\EventStoreCore.Hangfire.csproj" />
    <ProjectReference Include="..\..\src\EventStoreCore.Quartz\EventStoreCore.Quartz.csproj" />
    <ProjectReference Include="..\..\src\EventStoreCore.TickerQ\EventStoreCore.TickerQ.csproj" />
    <ProjectReference Include="..\..\src\EventStoreCore.Scheduling\EventStoreCore.Scheduling.csproj" />
    <ProjectReference Include="..\..\src\EventStoreCore.Postgres\EventStoreCore.Postgres.csproj" />
    <ProjectReference Include="..\..\src\EventStoreCore\EventStoreCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
