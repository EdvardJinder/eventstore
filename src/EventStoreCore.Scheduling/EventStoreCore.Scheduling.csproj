<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0-beta.1</Version>

    <PackageId>EventStoreCore.Scheduling</PackageId>
    <Authors>Edvard Jinder</Authors>
    <Company>Intromedia Digital AB</Company>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Description>Shared scheduling abstractions for EventStoreCore scheduler integrations.</Description>
    <PackageTags>eventstore event-sourcing scheduling hangfire quartz</PackageTags>
    <PackageProjectUrl>https://github.com/EdvardJinder/eventstore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EdvardJinder/eventstore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventStoreCore.Abstractions\EventStoreCore.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EventStoreCore" />
    <InternalsVisibleTo Include="EventStoreCore.Hangfire" />
    <InternalsVisibleTo Include="EventStoreCore.Quartz" />
    <InternalsVisibleTo Include="EventStoreCore.TickerQ" />
    <InternalsVisibleTo Include="EventStoreCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
